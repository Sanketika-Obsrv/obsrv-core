<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
				 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
				 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/maven-v4_0_0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>org.sunbird.obsrv</groupId>
	<artifactId>pipeline</artifactId>
	<version>1.0</version>
	<packaging>pom</packaging>
	<name>Core Data Pipeline</name>
	<description>
		Core Pipeline Jobs for Data Processing
	</description>
	<url>https://sunbird.org/</url>

	<modules>
		<module>extractor</module>
		<module>preprocessor</module>
		<module>denormalizer</module>
		<module>transformer</module>
		<module>dataset-router</module>
		<module>unified-pipeline</module>
		<module>hudi-connector</module>
		<module>cache-indexer</module>
	</modules>

	<properties>
		<!-- maven specific properties -->
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<scala.maj.version>2.12</scala.maj.version>
		<!-- 2.12.18: matches main's own scala.version (bd579898), needed for hudi-connector's
		     build on this branch. Closer to hudi-connector in the parent chain than root
		     pom.xml, so it was overriding that bump too. -->
		<scala.version>2.12.18</scala.version>
		<!-- 1.20.5: matches framework's own bump (see framework/pom.xml). Left at 1.17.2 while
		     framework moved to 1.20.5 meant extractor/preprocessor/etc. compiled against a
		     1.20-built framework with 1.17 Flink jars on their own classpath - scalac stubbed
		     missing 1.20-only interfaces (e.g. LineageVertexProvider) and failed. Bumping this
		     to match is the fix; each of the 6 modules below gets whatever compile-error fallout
		     that surfaces addressed on its own terms, not papered over. -->
		<flink.version>1.20.5</flink.version>
		<kafka.version>3.7.1</kafka.version>
		<java.target.runtime>11</java.target.runtime>
		<jackson-jaxrs.version>1.9.13</jackson-jaxrs.version>
		<scoverage.plugin.version>1.4.0</scoverage.plugin.version>
	</properties>

	<repositories>
		<repository>
			<id>my-local-repo</id>
			<url>file://${user.home}/.m2/repository</url>
		</repository>
		<repository>
			<id>apache-releases</id>
			<url>https://repository.apache.org/content/groups/public</url>
		</repository>
	</repositories>
	<!-- scala-tools.org / oss.sonatype.org/content/groups/scala-tools <repository> and
	     <pluginRepository> entries removed - the URL 404s (verified), dead for years, and
	     nothing in this reactor actually needs it. -->

	<dependencies>
		<dependency>
			<groupId>org.apache.flink</groupId>
			<artifactId>flink-streaming-scala_${scala.maj.version}</artifactId>
			<version>${flink.version}</version>
		</dependency>
	</dependencies>

	<build>
		<pluginManagement>
			<plugins>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-compiler-plugin</artifactId>
					<version>3.8.1</version>
					<configuration>
						<source>${java.target.runtime}</source>
						<target>${java.target.runtime}</target>
					</configuration>
				</plugin>
				<plugin>
				<groupId>org.scoverage</groupId>
					<artifactId>scoverage-maven-plugin</artifactId>
					<version>${scoverage.plugin.version}</version>
					<configuration>
						<scalaVersion>${scala.version}</scalaVersion>
						<aggregate>true</aggregate>
						<highlighting>true</highlighting>
					</configuration>
				</plugin>
			</plugins>
		</pluginManagement>
	</build>
</project>
